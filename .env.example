# ~/.env keys. Copy to .env and edit. Flags gate everything dangerous,
# all off by default:

# Opens a real browser against real sites (needed for roam/live at all)
ZF_ALLOW_BROWSER=0

# Signs & broadcasts a real transaction on Solana mainnet (launch)
ZF_SOL_LIVE=0

# Publishes site/ to zfbrain.online via Cloudflare Pages (zfsite.py --deploy)
ZF_SITE_LIVE=0

# Brains
ZF_STATE_DIR=.state
ZF_GRAPH=build/graph.npz
ZF_ESCAPE_HZ=30                # Mauthner rate that counts as a startle
ZF_DEP_U=0.002                 # habituation: synaptic resource used per sensory spike
ZF_DEP_TAU=20                  # habituation: seconds to recover

# The real connectome (fetch_cave.py). Both come with the data-access email;
# the token is never echoed.
ZF_CAVE_DATASTACK=
CAVE_AUTH_TOKEN=

# Roaming
ZF_ROAM_OPEN=0
ZF_ROAM_PORT=4660
ZF_ROAM_HOPS=12
ZF_ALLOWLIST=wikipedia.org,wikimedia.org,wikisource.org,gutenberg.org,openlibrary.org,arxiv.org,xkcd.com,pump.fun,raydium.io,solscan.io,explorer.solana.com

# Live feed (roam.py serves /state /frame.jpg /events on 127.0.0.1:ZF_ROAM_PORT;
# the named tunnel exposes it as https://live.zfbrain.online)
ZF_LIVE_ORIGINS=https://zfbrain.online,https://www.zfbrain.online,https://zfbrain.pages.dev,http://localhost:8787
ZF_LIVE_MAX_SSE=200
ZF_TUNNEL_TOKEN=               # from the Cloudflare tunnel (bin/tunnel.sh); never echo

# Cloudflare (zfsite.py --deploy). Zone-scoped token: Pages:Edit, DNS:Edit,
# Cloudflare Tunnel:Edit. Never echoed, never committed.
CF_API_TOKEN=
CF_ACCOUNT_ID=1b830f55dc609c3dd6f6fe2d30daee47

# Launch on pump.fun (Solana memecoin launchpad)
ZF_SOL_RPC=https://api.mainnet-beta.solana.com
SOL_PRIVATE_KEY=               # from solkeygen.py --env; never echo
ZF_SOL_DEVNET=0
ZF_SOL_TAX=25                  # transfer-fee basis points on Token-2022

# Voice / narrator (Anthropic SDK; a posting path is optional)
ZF_VOICE_EVERY_H=6
ZF_VOICE_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# optional, used by xpost.py if you wire a posting service
POST_URL=

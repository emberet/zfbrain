# ~/.env keys. Copy to .env and edit. Two flags gate everything dangerous,
# both off by default:

# Opens a real browser against real sites (needed for roam/live at all)
ZF_ALLOW_BROWSER=0

# Signs & broadcasts a real transaction on Solana mainnet (launch)
ZF_SOL_LIVE=0

# Brains
ZF_STATE_DIR=.state
ZF_GRAPH=build/graph.npz

# Roaming
ZF_ROAM_OPEN=0
ZF_ROAM_PORT=4660
ZF_ROAM_HOPS=12
ZF_ALLOWLIST=wikipedia.org,roam.wiki,wikimedia.org,wikisource.org,gutenberg.org,openlibrary.org,arxiv.org,xkcd.com,pump.fun,raydium.io,solscan.io,explorer.solana.com

# Launch on pump.fun (Solana memecoin launchpad)
ZF_SOL_RPC=https://api.mainnet-beta.solana.com
ZF_SOL_PRIVATE_KEY=            # from solkeygen.py --env; never echo
ZF_SOL_DEVNET=0
ZF_SOL_TAX=25                  # transfer-fee basis points on Token-2022

# Voice / narrator (needs an LLM key + a posting path)
ZF_VOICE_EVERY_H=6
LLM_API_KEY=
# optional, used by xpost.py if you wire a posting service
POST_URL=

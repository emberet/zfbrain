# secrets
.env

# data & artifacts
data/
# build/* not build/, or the negation below cannot reach inside it: git does
# not descend into an excluded directory
build/*
.state/
recordings/
# ...except the calibration. It is four numbers that take a bisection to find,
# and "build/ is gitignored, so the only copy was the one overwritten" is
# already the postmortem of two separate incidents (4f03186, and a --smoke
# build during step 08). Tracked so there is a second copy.
!build/calibration.json

# python
__pycache__/
*.pyc
.venv/
venv/

# node / site builds
node_modules/
dist/

# os
.DS_Store

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example

# the heartbeat lives in .state/ and on the live feed; a copy under site/
# would be published by zfsite.py as a stale snapshot nothing reads
site/live.json
site/web/

# macOS junk that would otherwise ride into a deploy
site/.DS_Store
